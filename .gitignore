# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Environnement
.env
.env.local
*.local

# Certificat racine local (antivirus/proxy qui inspecte HTTPS) — spécifique au
# poste, jamais dans le dépôt. Voir docs/adr/2026-08-13-certificat-racine-build-docker.md
infra/certs/*.crt

# Certificats Let's Encrypt et challenges ACME — propres à chaque serveur de
# production, jamais dans le dépôt (voir docker-compose.prod.yml, service
# certbot, et docs/05-deploiement.md).
infra/certbot/conf/*
infra/certbot/www/*
!infra/certbot/conf/.gitkeep
!infra/certbot/www/.gitkeep

# Données — jamais dans git
donnees/
sauvegardes/
*.dump
*.sql.gz
.env.prod

# Éditeurs / outils locaux
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
.claude/
